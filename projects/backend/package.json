{
  "name": "backend",
  "version": "1.0.0",
  "exports": {
    "./db": "./src/db/index.ts",
    "./db/schema": "./src/db/schema.ts"
  },
  "scripts": {
    "db:migrate": "bun run scripts/db-migrate.ts",
    "create-missing-leaderboards": "bun run scripts/create-missing-scoresaber-leaderboards.ts",
    "dev": "bun run --watch src/index.ts",
    "build": "bun build --compile --sourcemap --target bun --outfile ssr-backend src/index.ts src/service/suggested-maps/suggested-maps-fit.worker.ts",
    "start": "NODE_ENV=production ./ssr-backend",
    "lint": "oxlint src test",
    "test": "bun run test:unit && bun run test:integration",
    "test:unit": "bun test --concurrency 1 --path-ignore-patterns '**/*.integration.test.ts' src test/unit",
    "test:integration": "bun test --concurrency 1 --timeout 30000 --preload ./test/setup-db.ts test/integration .integration.test.ts",
    "test:docker": "cd ../.. && docker build -f projects/backend/Dockerfile.test -t ssr-backend-test . && docker run --rm --network host ssr-backend-test"
  },
  "dependencies": {
    "@discordx/importer": "^1.3.3",
    "@discordx/utilities": "^8.0.0",
    "@dotenvx/dotenvx": "^2.38.2",
    "@elysiajs/cors": "^1.4.3",
    "@elysiajs/server-timing": "^1.4.1",
    "@prometheus-io/client": "^0.16.1",
    "@ssr/common": "workspace:common",
    "@tqman/nice-logger": "^1.1.1",
    "better-auth": "file:../../vendor/better-auth/better-auth-1.7.7.tgz",
    "croner": "^11.0.1",
    "devalue": "^6.0.3",
    "discord.js": "^14.28.1",
    "discordx": "^11.13.3",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "elysia": "2.0.0-rc.4",
    "elysia-helmet": "^3.1.0",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "systeminformation": "^5.33.23",
    "typebox": "^1.4.7"
  },
  "devDependencies": {
    "@interfere/landmines": "^0.1.0",
    "@types/bun": "^1.4.4",
    "@types/pg": "^8.23.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "drizzle-kit": "^0.31.11",
    "msw": "^2.15.0",
    "oxlint": "^1.94.0",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
