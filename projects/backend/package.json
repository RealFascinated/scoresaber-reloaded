{
  "name": "backend",
  "version": "1.0.0",
  "exports": {
    "./db": "./src/db/index.ts",
    "./db/schema": "./src/db/schema.ts"
  },
  "scripts": {
    "db:migrate": "bun run scripts/db-migrate.ts",
    "create-missing-leaderboards": "bun run scripts/create-missing-scoresaber-leaderboards.ts",
    "dev": "bun run --watch src/index.ts",
    "build": "bun build --compile --target bun --outfile ssr-backend src/index.ts",
    "start": "NODE_ENV=production ./ssr-backend",
    "lint": "eslint src/**/*.ts",
    "test": "bun run test:unit && bun run test:integration",
    "test:unit": "bun test --concurrency 1 test/unit/common test/unit/db/converter test/unit/playlist-song-utils test/unit/playlist-to-bplist.test.ts test/unit/service",
    "test:integration": "bun test --concurrency 1 --timeout 30000 --preload ./test/setup-db.ts test/integration test/unit/repositories",
    "test:docker": "cd ../.. && docker build -f projects/backend/Dockerfile.test -t ssr-backend-test . && docker run --rm --network host ssr-backend-test"
  },
  "dependencies": {
    "@discordx/importer": "^1.3.3",
    "@discordx/utilities": "^8.0.0",
    "@dotenvx/dotenvx": "^2.33.0",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/cron": "^1.4.2",
    "@elysiajs/openapi": "^1.4.16",
    "@elysiajs/server-timing": "^1.4.1",
    "@eslint/js": "^10.0.1",
    "@prometheus-io/client": "^0.16.1",
    "@sinclair/typebox": "^0.34.52",
    "@ssr/common": "workspace:common",
    "@tqman/nice-logger": "^1.1.1",
    "devalue": "^6.0.2",
    "discord.js": "^14.27.0",
    "discordx": "^11.13.3",
    "dotenv": "^18.0.5",
    "drizzle-orm": "^0.45.3",
    "elysia": "^1.4.30",
    "elysia-helmet": "^3.1.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "systeminformation": "^5.33.15",
    "typescript-eslint": "^8.71.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/pg": "^8.23.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
